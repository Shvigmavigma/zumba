# Copy to .env before running docker compose.
APP_DOMAIN=localhost
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
STEAM_OPENID_URL=https://steamcommunity.com/openid/login

POSTGRES_DB=bmrl
POSTGRES_USER=bmrl
POSTGRES_PASSWORD=change-this-postgres-password
DATABASE_URL=postgresql+asyncpg://bmrl:change-this-postgres-password@postgres:5432/bmrl

JWT_SECRET=change-this-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

ADMIN_LOGIN=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

WEB_CONCURRENCY=4
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=20
RATE_LIMIT_DEFAULT=3/minute
RATE_LIMIT_STORAGE_URI=redis://redis:6379/0
AUTO_CREATE_TABLES=true

TWITCH_CHANNEL_LOGIN=BMRLRacing
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_STATUS_CACHE_SECONDS=60
