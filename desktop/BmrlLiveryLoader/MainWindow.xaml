<Window x:Class="BmrlLiveryLoader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BMRL · Загрузчик ливрей"
        Icon="/BmrlLiveryLoader;component/Assets/bmrl-logo-light-cutout.png"
        Width="840" Height="710" MinWidth="680" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5FB"
        FontFamily="Segoe UI"
        Foreground="{StaticResource TextBrush}"
        Loaded="Window_Loaded">
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="760" Margin="24,20" HorizontalAlignment="Center">
        <Border Padding="18,14" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
          <DockPanel LastChildFill="False">
            <Image Width="144" Height="32" Stretch="Uniform" Source="/BmrlLiveryLoader;component/Assets/bmrl-logo-light-cutout.png" />
            <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandNavy}" Text="Загрузчик ливрей" />
          </DockPanel>
        </Border>

        <Border x:Name="UpdateNoticePanel" Margin="0,10,0,0" Padding="11,8" Background="#EAF2FF" BorderBrush="#9BB9F2" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
          <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right" Margin="12,0,0,0" Padding="11,6" Style="{StaticResource PrimaryButton}" Click="DownloadUpdate_Click" Content="Скачать обновление" />
            <TextBlock x:Name="UpdateVersionText" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource BrandNavy}" Text="Доступна новая версия загрузчика" TextWrapping="Wrap" />
          </DockPanel>
        </Border>

        <TextBlock Margin="2,23,2,5" FontSize="24" FontWeight="Bold" Text="Установка ливрей ACC" />
        <TextBlock Margin="2,0,2,15" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="Установите ливрею выбранного пилота или сразу весь доступный каталог BMRL. Архивы будут кэшироваться на компьютере." />

        <Border Padding="16" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
          <StackPanel>
            <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Профиль пилота" />
            <TextBox x:Name="ProfileInput" />
            <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="Введите ID или ссылку вида https://bmrl.site/pilots/58." />
          </StackPanel>
        </Border>

        <Border Margin="0,12,0,0" Padding="16" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Папки Assetto Corsa Competizione" TextWrapping="Wrap" />
              <Button Grid.Column="1" Padding="10,6" Click="DetectFolders_Click" Content="Найти автоматически" />
            </Grid>

            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Cars" />
              <TextBox x:Name="CarsFolderInput" Grid.Column="1" Margin="8,0" IsReadOnly="True" />
              <Button Grid.Column="2" Padding="11,8" Click="BrowseCars_Click" Content="Выбрать…" />
            </Grid>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Liveries" />
              <TextBox x:Name="LiveriesFolderInput" Grid.Column="1" Margin="8,0" IsReadOnly="True" />
              <Button Grid.Column="2" Padding="11,8" Click="BrowseLiveries_Click" Content="Выбрать…" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Margin="0,12,0,0" Padding="14" Background="#F8FAFE" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Если файлы уже существуют" />
            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="Они не будут перезаписаны. Приложение покажет список пропущенных файлов после установки." />
          </StackPanel>
        </Border>

        <Border Margin="0,12,0,0" Padding="14" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
          <StackPanel>
            <TextBlock x:Name="StatusText" FontWeight="SemiBold" Text="Готово к установке" />
            <TextBlock x:Name="DetailsText" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            <TextBox x:Name="ConflictsText" Margin="0,8,0,0" Padding="8" MinHeight="72" MaxHeight="130" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" />
          </StackPanel>
        </Border>

        <Grid Margin="0,14,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button x:Name="InstallButton" Padding="14,13" HorizontalAlignment="Stretch" Click="Install_Click" Content="Установить ливрею пилота" />
          <Button x:Name="InstallAllButton" Grid.Column="2" Padding="14,13" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}" Click="InstallAll_Click" Content="Установить все ливреи BMRL" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
